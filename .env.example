# Optional: docker compose up --build also works without a .env file.
# demo = programmatic template replies (no API key, not a real model).
# openai = real council via OpenAI Responses API (6 model calls per full discussion).
AI_PROVIDER=openai

# Backend only. Never prefix secrets with NEXT_PUBLIC_.
# Get the key at https://platform.openai.com/api-keys
# (same key type used for Codex / OpenAI Platform billing).
OPENAI_API_KEY=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

# Prefer a chat model with structured JSON output support.
# Good defaults for the council: gpt-4o-mini or gpt-4o
# Coding-only Codex models may reject structured parse — use a general chat model.
OPENAI_MODEL=gpt-4o-mini

# Leave empty for the official OpenAI endpoint. Set only for a compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

OPENAI_TIMEOUT_SECONDS=90

# Host ports for Docker Compose. Container ports remain 3000 and 8000.
WEB_PORT=3000
API_PORT=8000

# Next.js server variable for development WITHOUT Docker.
# Next reads frontend/.env.local or the shell, not this root .env file.
# Example: API_INTERNAL_URL=http://127.0.0.1:8000 npm run dev
# Compose always uses http://backend:8000 for container-to-container requests.
# API_INTERNAL_URL=http://127.0.0.1:8000
